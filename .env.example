# Dashboard password (what you type on each device, once).
FACTORY_PASSWORD=
# Token the Claude Code hooks send. Generate with: openssl rand -hex 24
FACTORY_HOOK_TOKEN=
# Deployed only: where to pull specs from. Use a fine-grained, read-only GitHub token.
# SPECS_GIT_URL=https://<token>@github.com/<you>/swfactory.git
# SPECS_GIT_BRANCH=main
# SPECS_SYNC_SECONDS=60
# Token the host-side runner sends to claim jobs. Separate from the hook token on purpose.
FACTORY_RUNNER_TOKEN=

{
  "name": "swfactory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spec-driven software factory with a live dashboard of projects, features and Claude sessions.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "install-hooks": "node scripts/install-hooks.ts",
    "shoot": "node --disable-warning=ExperimentalWarning scripts/shoot.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2"
  }
}
